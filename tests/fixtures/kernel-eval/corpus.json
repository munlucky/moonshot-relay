          "tests/parser.test.mjs": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport { parseCount } from '../src/parser.ts';\n\ntest('preserves valid numeric values and returns null for invalid numeric text', () => {\n  for (const value of ['42', '0', '17']) assert.equal(parseCount(value), Number(value));\n  for (const value of ['invalid', '12oops', 'NaN']) assert.equal(parseCount(value), null);\n});\n"
