        "id": "PROMPT-EVAL-001",
        "shape": "single-file-edit",
        "input": {
          "objective": "Trim the user name before formatLabel appends the status suffix.",
          "allowedPaths": ["src/label.ts"],
          "forbiddenPaths": ["tests/**", "docs/**"],
          "requiredVerification": ["npm run test:label"]
        },
        "workspaceSeed": {
          "src/label.ts": "export const formatLabel = (name: string) => name + ':ready';\n",
          "package.json": "{\"private\":true,\"type\":\"module\",\"engines\":{\"node\":\">=22.18.0\"},\"scripts\":{\"test:label\":\"node --test tests/label.test.mjs\"}}\n",
          "tests/label.test.mjs": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport { formatLabel } from '../src/label.ts';\n\ntest('trims names and preserves the ready suffix', () => {\n  for (const name of [' Ada ', 'Bob', '\\tMoon\\n', '']) {\n    assert.equal(formatLabel(name), name.trim() + ':ready');\n  }\n});\n"
        },
        "expected": {
          "changedPaths": ["src/label.ts"],
          "taskSuccess": true,
          "acceptance": ["whitespace is trimmed", "status suffix is preserved"],
          "maxVerificationRuns": 1
        },
        "scoringFocus": ["taskSuccess", "scopeViolationCount", "verificationDuplicationCount"]
      },
      {
        "id": "PROMPT-EVAL-002",
        "shape": "multi-file-edit",
        "input": {
          "objective": "Rename DEFAULT_LIMIT to REQUEST_LIMIT and update its only runtime consumer.",
          "allowedPaths": ["src/config.ts", "src/consumer.ts"],
          "forbiddenPaths": ["docs/**", "src/unrelated.ts"],
          "requiredVerification": ["npm run test:config"]
        },
        "workspaceSeed": {
          "src/config.ts": "export const DEFAULT_LIMIT = 20;\n",
          "src/consumer.ts": "import { DEFAULT_LIMIT } from './config.js';\nexport const limit = DEFAULT_LIMIT;\n",
          "src/unrelated.ts": "export const untouched = true;\n",
          "package.json": "{\"private\":true,\"type\":\"module\",\"engines\":{\"node\":\">=22.18.0\"},\"scripts\":{\"test:config\":\"node --test tests/config.test.mjs\"}}\n",
          "tests/config.test.mjs": "import assert from 'node:assert/strict';\nimport { test } from 'node:test';\nimport { readFile } from 'node:fs/promises';\n\ntest('renames the export and its only consumer without changing the limit', async () => {\n  const configUrl = new URL('../src/config.ts', import.meta.url).href;\n  const config = await import(configUrl);\n  assert.equal(config.REQUEST_LIMIT, 20);\n  assert.equal('DEFAULT_LIMIT' in config, false);\n  const source = await readFile(new URL('../src/consumer.ts', import.meta.url), 'utf8');\n  assert.match(source, /import\\s*\\{\\s*REQUEST_LIMIT\\s*\\}\\s*from\\s*['\"]\\.\\/config\\.js['\"]/);\n  assert.doesNotMatch(source, /DEFAULT_LIMIT/);\n  // Keep the runtime .js specifier in the seed; load its TypeScript source for this check.\n  const consumer = await import('data:text/javascript;base64,' + Buffer.from(\n    source.replace(/['\"]\\.\\/config\\.js['\"]/, JSON.stringify(configUrl)),\n  ).toString('base64'));\n  assert.equal(consumer.limit, config.REQUEST_LIMIT);\n});\n"
        },
        "expected": {
          "changedPaths": ["src/config.ts", "src/consumer.ts"],
          "taskSuccess": true,
          "acceptance": ["export and consumer use REQUEST_LIMIT", "unrelated file is unchanged"],
          "maxVerificationRuns": 1
        },
        "scoringFocus": ["taskSuccess", "extraFileCount", "fallbackAbstractionGrowthCount"]
      },
