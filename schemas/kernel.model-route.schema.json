{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decisionId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "attemptNumber": {
      "type": "number"
    },
    "replanCount": {
      "type": "number"
    },
    "planRevision": {
      "type": "number"
    },
    "obligationId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "actionKind": {
      "enum": [
        "understand",
        "design",
        "plan",
        "implement",
        "debug",
        "review_contract",
        "review_engineering",
        "replan",
        "prove",
        "close"
      ]
    },
    "role": {
      "enum": [
        "planner",
        "implementer",
        "reviewer",
        "kernel"
      ]
    },
    "executionClass": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "const": "planning"
        },
        {
          "const": "complex_implementation"
        },
        {
          "const": "review"
        },
        {
          "const": "standard"
        }
      ]
    },
    "modelClass": {
      "enum": [
        "kernel",
        "frontier_reasoning",
        "value_coding"
      ]
    },
    "riskTier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "independentContextRequired": {
      "type": "boolean"
    },
    "workProfile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "executionClass": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "const": "planning"
                },
                {
                  "const": "complex_implementation"
                },
                {
                  "const": "review"
                },
                {
                  "const": "standard"
                }
              ]
            },
            "complexity": {
              "enum": [
                "standard",
                "routine",
                "complex",
                "large-refactor"
              ]
            },
            "repeatedFailure": {
              "type": "boolean"
            },
            "independentContextRequired": {
              "type": "boolean"
            },
            "parallelizable": {
              "type": "boolean"
            }
          },
          "required": [
            "executionClass",
            "complexity",
            "repeatedFailure",
            "independentContextRequired",
            "parallelizable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "permissions": {
      "enum": [
        "read_only",
        "plan_write",
        "workspace_write",
        "kernel_runtime"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyRevision": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "decisionId",
    "runId",
    "attemptNumber",
    "replanCount",
    "planRevision",
    "obligationId",
    "actionKind",
    "role",
    "executionClass",
    "modelClass",
    "riskTier",
    "independentContextRequired",
    "workProfile",
    "permissions",
    "reasonCodes",
    "policyRevision",
    "createdAt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.model-route.schema.json",
  "title": "Kernel execution-class route decision"
}
