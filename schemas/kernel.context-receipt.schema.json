{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-relay-kernel.local/schemas/kernel.context-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "stage",
    "policyRevision",
    "policyDigest",
    "tokenEstimate",
    "included",
    "omitted",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "FRAME",
        "SHAPE",
        "SLICE",
        "SCHEDULE",
        "EXECUTE",
        "PROVE",
        "CLOSE"
      ]
    },
    "policyRevision": {
      "type": "string"
    },
    "policyDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokenEstimate": {
      "type": "integer",
      "minimum": 0
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "revision",
          "contentDigest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "contentDigest": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "trust": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
