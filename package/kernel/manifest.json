{
  "schemaVersion": 1,
  "productId": "moon-relay-kernel",
  "runtimeHome": "~/.moon-relay-kernel",
  "entrypoint": "bin/moon-relay-kernel.mjs",
  "providerRuntimePolicy": {
    "mode": "native-provider",
    "managedRuntime": "kernel-node-only",
    "dataRoot": "native-provider-home",
    "executionLayer": "native-surface",
    "runtimeIsolation": "kernel-state-only",
    "completionAuthority": "kernel"
  },
  "include": [
    "bin/moon-relay-kernel.mjs",
    "bin/moon-relay-standalone.mjs",
    "bin/moon-harness-switcher.mjs",
    "kernel/",
    "scripts/kernel/",
    "scripts/host/kernel/",
    "scripts/switcher/",
    "scripts/lib/skills-lock.mjs",
    "scripts/lib/candidate-identity.mjs",
    "scripts/lib/git-safe.mjs",
    "schemas/kernel.*",
    "schemas/harness-switcher.*",
    "skills/moon-relay-kernel/",
    "skills/kernel-*",
    "skills/project-memory/",
    "skills/kernel-commit/",
    "skills/codebase-understanding/",
    "skills/explain-diff-html/",
    "skills/ui-audit/",
    "skills/product-definition/",
    "skills/architecture-artifacts/",
    "skills/codebase-master-guide/",
    "catalog/kernel-skills.yaml",
    "catalog/kernel-skills.json",
    "catalog/standalone-skills.json",
    "package/kernel/manifest.json",
    "package/kernel/skills.lock.json",
    "package/kernel/standalone-skills.lock.json",
    "package/kernel/profiles/"
    ,"package/profile-templates/codex/"
    ,"scripts/kernel/profile-install.mjs"
    ,"scripts/kernel/profile-doctor.mjs"
    ,"package/switcher/manifest.json"
    ,"package/switcher/"
  ],
  "exclude": [
    ".moonshot-relay",
    "runtime-state.sqlite",
    "package/claude/profile",
    "package/codex/profile",
    "package/qwen/profile"
  ]
}
