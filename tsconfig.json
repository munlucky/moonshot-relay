{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.mts", "tests/types/**/*.mts"],
  "exclude": ["node_modules", "dist"]
}
